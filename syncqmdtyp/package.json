{
  "name": "qmd2typ-pro",
  "displayName": "Quarto to Typst Workflow",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "20.x",
    "typescript": "^5.1.3",
    "eslint": "^8.41.0",
    "@typescript-eslint/parser": "^5.59.7",
    "@typescript-eslint/eslint-plugin": "^5.59.7"
  },
  "activationEvents": [
    "onLanguage:quarto"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qmd2typ.preview",
        "title": "Render to Typst",
        "icon": "$(play)"
      },
      {
        "command": "qmd2typ.viewTyp",
        "title": "View Typst Document",
        "icon": "$(eye)"
      },
      {
        "command": "qmd2typ.forwardSync",
        "title": "Forward Sync to Typst",
        "icon": "$(arrow-right)"
      }
    ],
    "keybindings": [
      {
        "command": "qmd2typ.viewTyp",
        "key": "cmd+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId == quarto"
      },
      {
        "command": "qmd2typ.forwardSync",
        "key": "cmd+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorLangId == quarto"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmd2typ.viewTyp",
          "when": "editorLangId == quarto",
          "group": "navigation@1"
        },
        {
          "command": "qmd2typ.forwardSync",
          "when": "editorLangId == quarto",
          "group": "navigation@2"
        }
      ]
    }
  }

}