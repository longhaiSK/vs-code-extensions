{
  "name": "qmd2typ-pro",
  "description": "One-click render and invserse-search for Quarto-Typst workflows.",
  "author": "Longhai Li",
  "publisher": "Prof-LonghaiLi",
  "repository": {
    "type": "git",
    "url": "https://github.com/longhaisk/vs-code-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/longhaisk/vs-code-extensions/issues"
  },
  "extensionDependencies": [
    "quarto.quarto",
    "myriad-dreamin.tinymist"
  ],
  "displayName": "Quarto-Tinymist Bidirectional Search",
  "version": "3.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "eslint": "^8.41.0",
    "typescript": "^5.1.3"
  },
  "activationEvents": [
    "onLanguage:quarto",
    "onLanguage:typst"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qmd2typ.preview",
        "title": "Render Quarto to Typst",
        "icon": "$(play)"
      },
      {
        "command": "qmd2typ.forwardSync",
        "title": "Forward Sync to Typst",
        "icon": "$(arrow-right)"
      }
    ],
    "keybindings": [
      {
        "command": "qmd2typ.preview",
        "key": "shift+cmd+v",
        "mac": "shift+cmd+v",
        "when": "editorLangId == quarto"
      },
      {
        "command": "qmd2typ.forwardSync",
        "key": "shift+cmd+f",
        "mac": "shift+cmd+f",
        "when": "editorLangId == quarto"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmd2typ.preview",
          "when": "editorLangId == quarto",
          "group": "navigation@1"
        },
        {
          "command": "qmd2typ.forwardSync",
          "when": "editorLangId == quarto",
          "group": "navigation@2"
        }
      ]
    }
  }
}
