{
  "name": "qmd2typ-pro",
  "description": "One-click render and invserse-search for Quarto-Typst workflows.",
  "author": "Longhai Li",
  "publisher": "Prof-LonghaiLi",
  "repository": {
    "type": "git",
    "url": "https://github.com/longhaisk/vs-code-extensions.git"
  },
  "bugs": {
    "url": "https://github.com/longhaisk/vs-code-extensions/issues"
  },
  "extensionDependencies": [
    "quarto.quarto",
    "myriad-dreamin.tinymist"
  ],
  "displayName": "Quarto-Tinymist Bidirectional Search",
  "version": "3.3.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "eslint": "^8.41.0",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "activationEvents": [
    "onLanguage:quarto",
    "onLanguage:typst"
  ],
  "contributes": {
    "commands": [
      {
        "command": "qmd2typ.preview",
        "title": "Render Quarto to Typst",
        "icon": "$(play)"
      },
      {
        "command": "qmd2typ.forwardSync",
        "title": "Forward Sync to Typst",
        "icon": "$(eye)"
      },
      {
        "command": "qmd2typ.exportPdf",
        "title": "Export Final PDF",
        "icon": "$(file-pdf)"
      },
      {
        "command": "qmd2typ.selectFormat",
        "title": "Select Typst Output Format",
        "icon": "$(list-selection)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "qmd2typ.preview",
          "when": "resourceExtname == .qmd",
          "group": "navigation@1"
        },
        {
          "command": "qmd2typ.forwardSync",
          "when": "resourceExtname == .qmd",
          "group": "navigation@2"
        },
        {
          "command": "qmd2typ.exportPdf",
          "when": "resourceExtname == .qmd",
          "group": "navigation@3"
        },
        {
          "command": "qmd2typ.selectFormat",
          "when": "resourceExtname == .qmd",
          "group": "navigation@4"
        }
      ]
    },
    "keybindings": [
      {
        "command": "qmd2typ.preview",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && resourceExtname == .qmd"
      },
      {
        "command": "qmd2typ.forwardSync",
        "key": "ctrl+shift+j",
        "mac": "cmd+shift+j",
        "when": "editorTextFocus && resourceExtname == .qmd"
      },
      {
        "command": "qmd2typ.exportPdf",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorTextFocus && resourceExtname == .qmd"
      }
    ]
  }
}
